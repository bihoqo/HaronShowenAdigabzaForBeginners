<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/constraintLayoutEntireFrame"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="ltr"
    tools:context=".activities.LessonActivity">

    <FrameLayout
        android:id="@+id/frameLayoutLessonSemitransparentBG"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4c000000"
        android:visibility="invisible"
        android:elevation="1000dp"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageViewLessonDebugMode"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:background="@drawable/debug_mode"
        android:translationZ="1000dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

<!--    &lt;!&ndash;    android:background="@drawable/background_scene"&ndash;&gt;-->
<!--    <androidx.appcompat.widget.AppCompatImageView-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent"-->
<!--        android:alpha="0.35"-->
<!--        android:scaleType="fitCenter" />-->

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolBarLesson"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewLessonQNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:text="-"
        android:textColor="@color/black"
        android:textSize="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewLessonQTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text=" / -"
        android:textColor="@color/black"
        android:textSize="14dp"
        app:layout_constraintBottom_toBottomOf="@id/textViewLessonQNumber"
        app:layout_constraintStart_toEndOf="@id/textViewLessonQNumber"
        app:layout_constraintTop_toTopOf="@id/textViewLessonQNumber" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/linearLayoutLessonSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/lesson_margin10a"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolBarLesson">

        <ImageView
            android:id="@+id/imageViewLessonExit"
            android:layout_width="@dimen/lesson_seekbar_height"
            android:layout_height="@dimen/lesson_seekbar_height"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="-10dp"
            android:onClick="buttonLessonViewExit"
            android:background="@drawable/exit230x228" />

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/seekBarLesson"
            android:layout_width="match_parent"
            android:layout_height="@dimen/lesson_seekbar_height"
            android:layout_gravity="center_vertical"
            android:layout_weight="1.0"
            android:indeterminate="false"
            android:max="5"
            android:progress="2"
            android:progressDrawable="@drawable/seekbar_progress"
            android:thumb="@drawable/seekbar_thumb" />

        <ImageView
            android:id="@+id/imageViewLessonFlower"
            android:layout_width="@dimen/lesson_seekbar_flower_size"
            android:layout_height="@dimen/lesson_seekbar_flower_size"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="-10dp"
            android:layout_marginRight="4dp"
            android:background="@drawable/flower230x223" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textViewLessonFlowers"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/lesson_seekbar_flower_size"
            android:textDirection="ltr"
            android:text="5"
            android:textSize="@dimen/lesson_seekbar_flowers_text_size"
            android:textColor="@color/flowers_text_color"
            android:gravity="center"/>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <FrameLayout
        android:id="@+id/frameLayoutLessonFragmentQuestion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/frame_layout_lesson_fragment_margin1"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutLessonSeekBar"
        app:layout_constraintBottom_toTopOf="@+id/buttonLessonSelect"/>

    <FrameLayout
        android:id="@+id/frameLayoutLessonResultBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#E9E9E9"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@id/linearLayoutLessonResult"/>

    <LinearLayout
        android:id="@+id/linearLayoutLessonResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/lesson_padding1"
        android:layout_marginBottom="@dimen/lesson_margin1"
        android:orientation="vertical"
        android:visibility="invisible"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/buttonLessonSelect">

        <ImageView
            android:id="@+id/imageViewLessonResult"
            android:layout_width="@dimen/lesson_image_size1"
            android:layout_height="@dimen/lesson_image_size1"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/i9004_transparent_no_shadow_230x230" />

        <TextView
            android:id="@+id/textViewLessonResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:gravity="center_horizontal"
            android:text="@string/lesson_correct_answer"
            android:textColor="@color/black"
            android:textSize="@dimen/lesson_text_size1" />
    </LinearLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/linearLayoutLessonDebugNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonLessonPickWrongAnswer"
            android:tag="pick_wrong_answer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="left"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/background_option_unselected"
            android:onClick="buttonLessonPickAnswerClicked"
            android:text="x"
            android:textColor="@color/red"
            android:textSize="@dimen/text_size_select"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonLessonPickCorrectAnswer"
            android:tag="pick_correct_answer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="left"
            android:layout_marginEnd="4dp"
            android:background="@drawable/background_option_unselected"
            android:onClick="buttonLessonPickAnswerClicked"
            android:text="V"
            android:textColor="@color/green"
            android:textSize="@dimen/text_size_select"/>

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/seekBarLessonDebugNav"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="right"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:indeterminate="false"
            android:max="90"
            android:progress="12"
            android:progressDrawable="@drawable/seekbar_progress"
            android:thumb="@drawable/seekbar_thumb"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonLessonPreviousX"
            android:tag="fast_rewind"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="right"
            android:layout_marginEnd="4dp"
            android:background="@drawable/background_option_unselected"
            android:onClick="buttonLessonNavigateClicked"
            android:text="&lt;&lt;"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_select"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonLessonNextX"
            android:tag="fast_forward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="right"
            android:layout_marginEnd="4dp"
            android:background="@drawable/background_option_unselected"
            android:onClick="buttonLessonNavigateClicked"
            android:text="&gt;&gt;"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_select"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonLessonPrevious"
            android:tag="rewind"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="right"
            android:layout_marginEnd="4dp"
            android:background="@drawable/background_option_unselected"
            android:onClick="buttonLessonNavigateClicked"
            android:text="&lt;"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_select"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonLessonNext"
            android:tag="forward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="right"
            android:layout_marginEnd="4dp"
            android:background="@drawable/background_option_unselected"
            android:onClick="buttonLessonNavigateClicked"
            android:text="&gt;"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_select"/>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonLessonSelect"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lesson_select_height"
        android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/background_select_disabled"
        android:enabled="false"
        android:onClick="buttonLessonSelectClicked"
        android:text="@string/button_select"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_select"
        app:layout_constraintBottom_toTopOf="@+id/linearLayoutLessonDebugNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenterVertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

<!--    sliding debug view-->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/linearLayoutLessonDebugPanel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:translationZ="100dp"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textViewLessonDebugPanel1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textDirection="ltr"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="8dp"
            android:layout_gravity="start|top"
            android:text="Debug text 1"
            android:textSize="14dp"
            android:background="#c0004411"
            android:textColor="#ffeeff33"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textViewLessonDebugPanel2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textDirection="ltr"
            android:layout_marginBottom="10dp"
            android:paddingHorizontal="8dp"
            android:layout_gravity="start|top"
            android:text="Debug text 2"
            android:textSize="14dp"
            android:background="#c0774411"
            android:textColor="#D5DAD9"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
