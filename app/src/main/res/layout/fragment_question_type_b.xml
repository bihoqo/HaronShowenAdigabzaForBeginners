<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.QuestionTypeBFragment">

    <TextView
        android:id="@+id/textViewLessonTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="locale"
        android:textDirection="locale"
        android:layout_marginHorizontal="@dimen/lesson_margin10b"
        android:layout_marginTop="@dimen/lesson_margin11"
        android:fontFamily="@font/opensans_semibold"
        android:gravity="start"
        android:text="@string/lesson_title_what_is_this"
        android:textColor="#3C3C3B"
        android:textSize="@dimen/lesson_text_size_question"
        android:textStyle="normal"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewLessonQuestion"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lesson_question_size"
        android:layout_marginHorizontal="@dimen/lesson_margin10b"
        android:layout_marginTop="@dimen/lesson_margin8"
        android:fontFamily="@font/opensans_semibold"
        android:gravity="center"
        android:text="Сэ ______ Налмэс"
        android:textColor="@color/lesson_sentence_text_color"
        android:textSize="@dimen/lesson_text_size_question"
        android:textStyle="normal"
        app:layout_constraintTop_toBottomOf="@+id/textViewLessonTitle" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/imageButtonLessonQuestion"
        android:visibility="invisible"
        android:layout_width="@dimen/lesson_question_size"
        android:layout_height="@dimen/lesson_question_size"
        android:layout_marginTop="@dimen/lesson_margin8"
        android:background="#00000000"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewLessonTitle" />
    <!--    android:background="@drawable/background_outline"-->
    <!--    android:outlineProvider="background"-->

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonLessonOption1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/lesson_margin10b"
        android:layout_marginTop="@dimen/lesson_margin8"
        android:paddingHorizontal="@dimen/lesson_padding3"
        android:background="@drawable/background_option_unselected"
        android:text="Тхьапэ"
        android:textAllCaps="false"
        android:textColor="@color/lesson_option_text_color_unselected"
        android:textSize="@dimen/fragment_b_text_size_options"
        app:layout_constraintBottom_toTopOf="@+id/buttonLessonOption2"
        app:layout_constraintTop_toBottomOf="@+id/imageButtonLessonQuestion"
        app:layout_constraintVertical_chainStyle="spread_inside" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonLessonOption2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/lesson_margin8"
        android:paddingHorizontal="@dimen/lesson_padding3"
        android:background="@drawable/background_option_unselected"
        android:text="Тхьакlумкlыхь"
        android:textAllCaps="false"
        android:textColor="@color/lesson_option_text_color_unselected"
        android:textSize="@dimen/fragment_b_text_size_options"
        app:layout_constraintStart_toStartOf="@+id/buttonLessonOption1"
        app:layout_constraintEnd_toEndOf="@+id/buttonLessonOption1"
        app:layout_constraintBottom_toTopOf="@+id/buttonLessonOption3"
        app:layout_constraintTop_toBottomOf="@+id/buttonLessonOption1"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonLessonOption3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/lesson_margin8"
        android:paddingHorizontal="@dimen/lesson_padding3"
        android:background="@drawable/background_option_unselected"
        android:text="Тхьакlумкlэхь"
        android:textAllCaps="false"
        android:textColor="@color/lesson_option_text_color_unselected"
        android:textSize="@dimen/fragment_b_text_size_options"
        app:layout_constraintStart_toStartOf="@+id/buttonLessonOption1"
        app:layout_constraintEnd_toEndOf="@+id/buttonLessonOption1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonLessonOption2" />

</androidx.constraintlayout.widget.ConstraintLayout>
