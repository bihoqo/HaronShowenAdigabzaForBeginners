<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="ltr"
    android:background="#1100ff00"
    android:padding="16dp">

    <TextView
        android:id="@+id/dialogplus_content_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sample Content Title"
        android:textColor="@android:color/black"
        android:textSize="20dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/dialogplus_content_choise1_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Choise #1"
            android:textColor="@color/dialogplus_black_overlay"
            android:textSize="16dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/dialogplus_content_choise2_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Choise #2"
            android:textColor="@color/dialogplus_black_overlay"
            android:textSize="16dp"/>
    </LinearLayout>
</LinearLayout>
