<!--TODO move to DrawerLayout instead of using Toolbar below-->

<!--    sw: smallest width (short-side of the display) in dp-->
<!--    Galaxy: 1080x2280, 5.8", 19:9, 448ppi ==> 1dp=2.8px, sw=385dp -->
<!--    OnePlus: 1080x2340, 6.41", 19.5:9, 402ppi ==> 1dp=2.5125px, sw=429dp -->
<!--    Xiaomi: 1080:2400, 6.67", 20:9, 395 ppi ==> 1dp=2.46875px, sw=437dp -->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraint_view_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:background="@color/white"
    android:visibility="visible"
    tools:context=".activities.MainActivity">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageViewMainDebugMode"
        android:layout_width="60dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:visibility="visible"
        android:translationZ="1000dp"
        android:background="@drawable/debug_mode"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewMainTitle"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/main_toolbar_height"
        android:textDirection="ltr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/main_title"
        android:textSize="@dimen/text_size_main_title"
        android:fontFamily="@font/opensans_semibold"
        android:textColor="#3c3c3b"
        android:gravity="center"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewMainSubTitle"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/main_toolbar_height"
        android:textDirection="ltr"
        app:layout_constraintStart_toEndOf="@+id/toolBarMain"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/alphabet_label_cyrillic"
        android:textSize="@dimen/text_size_main_subtitle"
        android:fontFamily="@font/opensans_regular"
        android:textColor="@color/subtitle_alphabet_text_color"
        android:gravity="center"/>

    <ImageView
        android:id="@+id/imageViewMainToolbarStar"
        android:layout_width="@dimen/main_toolbar_height"
        android:layout_height="@dimen/main_toolbar_height"
        app:layout_constraintEnd_toStartOf="@id/textViewMainToolbarStars"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginRight="4dp"
        android:background="@drawable/star_icon"
        android:gravity="center"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewMainToolbarStars"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/main_toolbar_height"
        android:textDirection="ltr"
        app:layout_constraintEnd_toStartOf="@id/imageViewMainToolbarFlower"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginRight="10dp"
        android:text="3"
        android:textSize="@dimen/text_size_main_subtitle"
        android:textColor="@color/stars_text_color"
        android:gravity="center"/>

    <ImageView
        android:id="@+id/imageViewMainToolbarFlower"
        android:layout_width="@dimen/main_toolbar_height"
        android:layout_height="@dimen/main_toolbar_height"
        android:layout_marginRight="4dp"
        android:background="@drawable/flower230x223"
        android:gravity="center"
        android:onClick="showDialogPlusFlowersMain"
        app:layout_constraintEnd_toStartOf="@+id/textViewMainToolbarFlowers"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewMainToolbarFlowers"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/main_toolbar_height"
        android:textDirection="ltr"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="20dp"
        android:text="5"
        android:textSize="@dimen/text_size_main_subtitle"
        android:textColor="@color/flowers_text_color"
        android:gravity="center"/>

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolBarMain"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/main_toolbar_height"
        android:layoutDirection="ltr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layoutDirection="ltr">
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>

    <FrameLayout
        android:id="@+id/frameLayoutMainPagerCover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/linearLayoutMainPager"
        app:layout_constraintBottom_toBottomOf="@+id/linearLayoutMainPager"
        app:layout_constraintStart_toStartOf="@+id/linearLayoutMainPager"
        app:layout_constraintEnd_toEndOf="@+id/linearLayoutMainPager"
        android:background="@color/black"
        android:elevation="-100000dp">
    </FrameLayout>
    <LinearLayout
        android:id="@+id/linearLayoutMainPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layoutDirection="ltr"
        android:background="@color/white"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/toolBarMain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="5dp"
            app:tabTextColor="@color/white"
            app:tabSelectedTextColor="@color/white"
            android:background="@color/white"
            app:tabTextAppearance="@style/LessonsTabLayoutStyle"
            app:tabBackground="@drawable/background_lessons_tablayout"
            app:tabIndicatorHeight="0dp"
            app:tabMinWidth="@dimen/min_width_main_stage_tab"
            app:tabMode="scrollable"/>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerMain"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/view_pager_main_margin_horizontal"
            android:layout_marginVertical="@dimen/view_pager_main_margin_vertical"
            android:layout_weight="1"/>
    </LinearLayout>

